        <img src="https://i.pinimg.com/736x/42/44/49/42444949de304d8208e9cf63ecd27ae3.jpg" alt="Moodboard 2">
        <img src="https://i.pinimg.com/736x/0d/44/65/0d4465a65fb0d8ffbb4c92acb0718964.jpg" alt="Moodboard 3">
      </div>

      <!-- Cute Music Player -->
      <div class="music-player">
        <span class="track-name">I AM - Ive</span>
        <button class="player-btn" id="playBtn">▶️</button>
        <!-- Added proper audio controls -->
        <audio id="audio" src="file:///C:/Users/Nadhifa%20Zalfaa%20I/Documents/EONYY/I%20AM.mp3"></audio>
      </div>
    </article>

    <!-- Aside / Interests -->
    <aside>
      <div class="column">
        <h2>Likes</h2>
        <ul>
          <li>Anime & Manga</li>
          <li>Music & Singing</li>
