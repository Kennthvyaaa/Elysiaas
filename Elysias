      <div class="column">
        <h2>Interests</h2>
        <ul>
          <li>Anime, Manga, Music, & Video Games</li>
          <li>Editing, Programming, & Drawing</li>
          <li>Mathematics, Science, & JFashion</li>
        </ul>
      </div>
    </aside>
  </div>

  <script>
    const playBtn = document.getElementById('playBtn');
    const audio = document.getElementById('audio');

    playBtn.addEventListener('click', () => {
      if(audio.paused){
        audio.play();
        playBtn.textContent = "⏸️";
      } else {
        audio.pause();
        playBtn.textContent = "▶️";
      }
    });
  </script>
</body>
</html>
